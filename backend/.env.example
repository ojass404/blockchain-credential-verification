PORT=3001
# Blockchain configuration is generated by npm run deploy:local in .local/deployment.json.
# Legacy RPC_URL, CHAIN_ID and REGISTRY_ADDRESS values are intentionally ignored.
# Origin allowed to make browser mutations (must match the frontend URL exactly).
PUBLIC_ORIGIN=http://127.0.0.1:5173
# DATABASE_PATH defaults to ignored .local/accounts.sqlite at repository root.
# Production requires an explicit DATABASE_PATH and HTTPS PUBLIC_ORIGIN.
# The application rejects a locally seeded database when NODE_ENV=production.
